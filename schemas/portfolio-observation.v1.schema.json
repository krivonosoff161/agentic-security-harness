{"$defs":{"SafeEvidencePointer":{"additionalProperties":false,"description":"Digest-shaped pointer with no raw payload or machine path.\n\nShape validation does not prove that the referenced content exists or is authentic.","properties":{"digest":{"pattern":"^[0-9a-f]{64}$","title":"Digest","type":"string"},"kind":{"enum":["artifact","event","policy","trace","report"],"title":"Kind","type":"string"},"locator_id":{"pattern":"^[0-9a-f]{64}$","title":"Locator Id","type":"string"}},"required":["kind","digest","locator_id"],"title":"SafeEvidencePointer","type":"object"}},"additionalProperties":false,"description":"Stable authority-free wire observation.\n\n``event_id`` remains a producer-claimed digest-shaped identifier. The separate\n:class:`ObservationCommitmentV1` binds canonical bytes without promoting that claim.","properties":{"activity":{"maxLength":128,"minLength":1,"pattern":"^[a-z][a-z0-9_.-]{0,127}$","title":"Activity","type":"string"},"authority_envelope_ref":{"anyOf":[{"pattern":"^[0-9a-f]{64}$","type":"string"},{"type":"null"}],"title":"Authority Envelope Ref"},"data_envelope_ref":{"pattern":"^[0-9a-f]{64}$","title":"Data Envelope Ref","type":"string"},"entity_refs":{"items":{"$ref":"#/$defs/SafeEvidencePointer"},"maxItems":64,"title":"Entity Refs","type":"array"},"event_id":{"pattern":"^[0-9a-f]{64}$","title":"Event Id","type":"string"},"occurred_at":{"format":"date-time","title":"Occurred At","type":"string"},"operational_authority":{"const":"none","title":"Operational Authority","type":"string"},"parent_event_ids":{"items":{"pattern":"^[0-9a-f]{64}$","type":"string"},"maxItems":64,"title":"Parent Event Ids","type":"array"},"producer_attestation":{"const":"unattested","title":"Producer Attestation","type":"string"},"producer_id_hash":{"pattern":"^[0-9a-f]{64}$","title":"Producer Id Hash","type":"string"},"project_id":{"pattern":"^[a-z0-9][a-z0-9-]{0,127}$","title":"Project Id","type":"string"},"repository_id":{"pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$","title":"Repository Id","type":"string"},"repository_sha":{"pattern":"^(?:[0-9a-f]{40}|[0-9a-f]{64})$","title":"Repository Sha","type":"string"},"schema_version":{"const":"portfolio-observation-v1.0","title":"Schema Version","type":"string"},"source_surface":{"enum":["user","agent","model","tool","mcp","retrieval","memory","document","app","sensor","environment","provider","audit"],"title":"Source Surface","type":"string"},"telemetry_state":{"enum":["complete","incomplete","malformed","unattested","conflicting"],"title":"Telemetry State","type":"string"}},"required":["schema_version","event_id","project_id","repository_id","repository_sha","occurred_at","producer_id_hash","producer_attestation","source_surface","activity","entity_refs","parent_event_ids","data_envelope_ref","authority_envelope_ref","telemetry_state","operational_authority"],"title":"CanonicalObservationEventV1","type":"object"}
