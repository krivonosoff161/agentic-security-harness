{
  "$defs": {
    "AdapterAuditV1": {
      "additionalProperties": false,
      "description": "Exhaustive, authority-aware accounting for one V1 projection.",
      "properties": {
        "schema_version": {
          "const": "portfolio-adapter-audit-v1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_model": {
          "enum": [
            "harness.runtime_guard_foundation",
            "handoff.metadata_sidecar",
            "runtime_guard.observation_event",
            "transfer_verifier.transfer_envelope"
          ],
          "title": "Source Model",
          "type": "string"
        },
        "target_model": {
          "const": "portfolio-observation-v1.0",
          "title": "Target Model",
          "type": "string"
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "rejected"
          ],
          "title": "Completeness",
          "type": "string"
        },
        "source_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Source Fields",
          "type": "array"
        },
        "target_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Target Fields",
          "type": "array"
        },
        "mappings": {
          "items": {
            "$ref": "#/$defs/AdapterFieldMappingV1"
          },
          "maxItems": 128,
          "title": "Mappings",
          "type": "array"
        },
        "dropped_source_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Dropped Source Fields",
          "type": "array"
        },
        "context_target_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Context Target Fields",
          "type": "array"
        },
        "constant_target_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Constant Target Fields",
          "type": "array"
        },
        "authority_downgrade": {
          "title": "Authority Downgrade",
          "type": "boolean"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Reason Codes",
          "type": "array"
        },
        "operational_authority": {
          "const": "none",
          "title": "Operational Authority",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "source_model",
        "target_model",
        "completeness",
        "source_fields",
        "target_fields",
        "mappings",
        "dropped_source_fields",
        "context_target_fields",
        "constant_target_fields",
        "authority_downgrade",
        "reason_codes",
        "operational_authority"
      ],
      "title": "AdapterAuditV1",
      "type": "object"
    },
    "AdapterFieldMappingV1": {
      "additionalProperties": false,
      "description": "Explicit source dependency to canonical target mapping.",
      "properties": {
        "source_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Source Fields",
          "type": "array"
        },
        "target_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Target Fields",
          "type": "array"
        },
        "transformation": {
          "enum": [
            "identity",
            "derived"
          ],
          "title": "Transformation",
          "type": "string"
        },
        "authority_effect": {
          "enum": [
            "none",
            "downgrade"
          ],
          "title": "Authority Effect",
          "type": "string"
        }
      },
      "required": [
        "source_fields",
        "target_fields",
        "transformation",
        "authority_effect"
      ],
      "title": "AdapterFieldMappingV1",
      "type": "object"
    },
    "CoverageExpectationProfileV1": {
      "additionalProperties": false,
      "description": "Precommitted expectation boundary; it is evidence, never authority.",
      "properties": {
        "schema_version": {
          "const": "portfolio-coverage-expectation-v1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Id",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,127}$",
          "title": "Project Id",
          "type": "string"
        },
        "repository_id": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repository Id",
          "type": "string"
        },
        "repository_sha": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Repository Sha",
          "type": "string"
        },
        "expected_channels": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Expected Channels",
          "type": "array"
        },
        "expected_event_count": {
          "maximum": 4096,
          "minimum": 1,
          "title": "Expected Event Count",
          "type": "integer"
        },
        "expectation_source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expectation Source Sha256",
          "type": "string"
        },
        "producer_attestation": {
          "const": "unattested",
          "title": "Producer Attestation",
          "type": "string"
        },
        "operational_authority": {
          "const": "none",
          "title": "Operational Authority",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "profile_id",
        "project_id",
        "repository_id",
        "repository_sha",
        "expected_channels",
        "expected_event_count",
        "expectation_source_sha256",
        "producer_attestation",
        "operational_authority"
      ],
      "title": "CoverageExpectationProfileV1",
      "type": "object"
    },
    "TrajectoryAccountingV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "portfolio-trajectory-accounting-v1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "trajectory_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trajectory Id",
          "type": "string"
        },
        "candidate_visibility": {
          "const": "evaluator_only",
          "title": "Candidate Visibility",
          "type": "string"
        },
        "logical_operation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Logical Operation Id",
          "type": "string"
        },
        "expected_event_count": {
          "maximum": 4096,
          "minimum": 1,
          "title": "Expected Event Count",
          "type": "integer"
        },
        "observed_event_count": {
          "maximum": 4096,
          "minimum": 0,
          "title": "Observed Event Count",
          "type": "integer"
        },
        "observation_horizon_started_at": {
          "format": "date-time",
          "title": "Observation Horizon Started At",
          "type": "string"
        },
        "observation_horizon_ended_at": {
          "format": "date-time",
          "title": "Observation Horizon Ended At",
          "type": "string"
        },
        "censoring_state": {
          "enum": [
            "complete",
            "left_censored",
            "right_censored"
          ],
          "title": "Censoring State",
          "type": "string"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/TrajectoryObservationRefV1"
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Observations",
          "type": "array"
        },
        "event_commitments": {
          "items": {
            "$ref": "#/$defs/TrajectoryCommitmentBindingV1"
          },
          "maxItems": 4096,
          "title": "Event Commitments",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/TrajectoryEdgeV1"
          },
          "maxItems": 262144,
          "title": "Edges",
          "type": "array"
        },
        "attempt_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 4096,
          "title": "Attempt Ids",
          "type": "array"
        },
        "idempotency_identities": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 4096,
          "title": "Idempotency Identities",
          "type": "array"
        },
        "route_violation_event_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 4096,
          "title": "Route Violation Event Ids",
          "type": "array"
        },
        "root_event_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 4096,
          "title": "Root Event Ids",
          "type": "array"
        },
        "leaf_event_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 4096,
          "title": "Leaf Event Ids",
          "type": "array"
        },
        "unresolved_parent_event_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 262144,
          "title": "Unresolved Parent Event Ids",
          "type": "array"
        },
        "duplicate_event_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 4096,
          "title": "Duplicate Event Ids",
          "type": "array"
        },
        "duplicate_observation_commitments": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 4096,
          "title": "Duplicate Observation Commitments",
          "type": "array"
        },
        "cycle_verdict": {
          "enum": [
            "acyclic",
            "cycle_detected"
          ],
          "title": "Cycle Verdict",
          "type": "string"
        },
        "completeness": {
          "enum": [
            "complete",
            "incomplete",
            "invalid"
          ],
          "title": "Completeness",
          "type": "string"
        },
        "operational_authority": {
          "const": "none",
          "title": "Operational Authority",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "trajectory_id",
        "candidate_visibility",
        "logical_operation_id",
        "expected_event_count",
        "observed_event_count",
        "observation_horizon_started_at",
        "observation_horizon_ended_at",
        "censoring_state",
        "observations",
        "event_commitments",
        "edges",
        "attempt_ids",
        "idempotency_identities",
        "route_violation_event_ids",
        "root_event_ids",
        "leaf_event_ids",
        "unresolved_parent_event_ids",
        "duplicate_event_ids",
        "duplicate_observation_commitments",
        "cycle_verdict",
        "completeness",
        "operational_authority"
      ],
      "title": "TrajectoryAccountingV1",
      "type": "object"
    },
    "TrajectoryCommitmentBindingV1": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Event Id",
          "type": "string"
        },
        "observation_commitment_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Commitment Sha256",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "observation_commitment_sha256"
      ],
      "title": "TrajectoryCommitmentBindingV1",
      "type": "object"
    },
    "TrajectoryEdgeV1": {
      "additionalProperties": false,
      "properties": {
        "parent_event_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Parent Event Id",
          "type": "string"
        },
        "child_event_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Child Event Id",
          "type": "string"
        }
      },
      "required": [
        "parent_event_id",
        "child_event_id"
      ],
      "title": "TrajectoryEdgeV1",
      "type": "object"
    },
    "TrajectoryObservationRefV1": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Event Id",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "observation_commitment_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Commitment Sha256",
          "type": "string"
        },
        "logical_operation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Logical Operation Id",
          "type": "string"
        },
        "attempt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "attempt_ordinal": {
          "maximum": 4096,
          "minimum": 1,
          "title": "Attempt Ordinal",
          "type": "integer"
        },
        "idempotency_identity": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Idempotency Identity",
          "type": "string"
        },
        "retry_cause": {
          "enum": [
            "initial",
            "bounded_retry",
            "policy_retry",
            "transport_retry",
            "unknown"
          ],
          "title": "Retry Cause",
          "type": "string"
        },
        "route_id_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Route Id Hash",
          "type": "string"
        },
        "route_transition_reason": {
          "enum": [
            "initial",
            "declared_failover",
            "policy_transition",
            "unknown"
          ],
          "title": "Route Transition Reason",
          "type": "string"
        },
        "permitted_route_set_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Permitted Route Set Sha256",
          "type": "string"
        },
        "route_permitted": {
          "title": "Route Permitted",
          "type": "boolean"
        },
        "constraint_encounters": {
          "items": {
            "enum": [
              "budget_boundary",
              "route_not_permitted",
              "time_boundary",
              "tool_boundary",
              "unknown"
            ],
            "type": "string"
          },
          "maxItems": 16,
          "title": "Constraint Encounters",
          "type": "array"
        },
        "parent_event_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Parent Event Ids",
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "occurred_at",
        "observation_commitment_sha256",
        "logical_operation_id",
        "attempt_id",
        "attempt_ordinal",
        "idempotency_identity",
        "retry_cause",
        "route_id_hash",
        "route_transition_reason",
        "permitted_route_set_sha256",
        "route_permitted",
        "constraint_encounters",
        "parent_event_ids"
      ],
      "title": "TrajectoryObservationRefV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "portfolio-telemetry-manifest-v1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "candidate_visibility": {
      "const": "evaluator_only",
      "title": "Candidate Visibility",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "repository_id": {
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "title": "Repository Id",
      "type": "string"
    },
    "repository_sha": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "title": "Repository Sha",
      "type": "string"
    },
    "coverage_expectation_profile": {
      "$ref": "#/$defs/CoverageExpectationProfileV1"
    },
    "coverage_expectation_profile_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Coverage Expectation Profile Id",
      "type": "string"
    },
    "window_started_at": {
      "format": "date-time",
      "title": "Window Started At",
      "type": "string"
    },
    "window_ended_at": {
      "format": "date-time",
      "title": "Window Ended At",
      "type": "string"
    },
    "expected_channels": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Expected Channels",
      "type": "array"
    },
    "observed_channels": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Observed Channels",
      "type": "array"
    },
    "dropped_record_count": {
      "minimum": 0,
      "title": "Dropped Record Count",
      "type": "integer"
    },
    "rejected_record_count": {
      "minimum": 0,
      "title": "Rejected Record Count",
      "type": "integer"
    },
    "adapter_audit": {
      "$ref": "#/$defs/AdapterAuditV1"
    },
    "trajectory_accounting": {
      "$ref": "#/$defs/TrajectoryAccountingV1"
    },
    "adapter_audit_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Adapter Audit Sha256",
      "type": "string"
    },
    "trajectory_accounting_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Trajectory Accounting Sha256",
      "type": "string"
    },
    "trajectory_completeness": {
      "enum": [
        "complete",
        "incomplete",
        "invalid"
      ],
      "title": "Trajectory Completeness",
      "type": "string"
    },
    "telemetry_state": {
      "enum": [
        "complete",
        "incomplete",
        "rejected"
      ],
      "title": "Telemetry State",
      "type": "string"
    },
    "incomplete_reason": {
      "enum": [
        "none",
        "missing_channel",
        "dropped_or_rejected_records",
        "trajectory_not_complete",
        "invalid_window"
      ],
      "title": "Incomplete Reason",
      "type": "string"
    },
    "operational_authority": {
      "const": "none",
      "title": "Operational Authority",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "candidate_visibility",
    "project_id",
    "repository_id",
    "repository_sha",
    "coverage_expectation_profile",
    "coverage_expectation_profile_id",
    "window_started_at",
    "window_ended_at",
    "expected_channels",
    "observed_channels",
    "dropped_record_count",
    "rejected_record_count",
    "adapter_audit",
    "trajectory_accounting",
    "adapter_audit_sha256",
    "trajectory_accounting_sha256",
    "trajectory_completeness",
    "telemetry_state",
    "incomplete_reason",
    "operational_authority"
  ],
  "title": "TelemetryManifestV1",
  "type": "object"
}
