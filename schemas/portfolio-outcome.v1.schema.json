{
  "$defs": {
    "AdvisoryOutcomeV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "portfolio-outcome-v1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "record_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Record Id",
          "type": "string"
        },
        "observation_commitment_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Commitment Sha256",
          "type": "string"
        },
        "producer_attestation": {
          "const": "unattested",
          "title": "Producer Attestation",
          "type": "string"
        },
        "evidence_only": {
          "const": true,
          "title": "Evidence Only",
          "type": "boolean"
        },
        "executable": {
          "const": false,
          "title": "Executable",
          "type": "boolean"
        },
        "operational_authority": {
          "const": "none",
          "title": "Operational Authority",
          "type": "string"
        },
        "layer": {
          "const": "advisory",
          "title": "Layer",
          "type": "string"
        },
        "reported_value": {
          "enum": [
            "observe",
            "challenge",
            "escalate",
            "abstain",
            "inconclusive"
          ],
          "title": "Reported Value",
          "type": "string"
        },
        "candidate_visibility": {
          "const": "visible",
          "title": "Candidate Visibility",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "record_id",
        "observation_commitment_sha256",
        "producer_attestation",
        "evidence_only",
        "executable",
        "operational_authority",
        "layer",
        "reported_value",
        "candidate_visibility"
      ],
      "title": "AdvisoryOutcomeV1",
      "type": "object"
    },
