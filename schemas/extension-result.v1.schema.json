{
  "$defs": {
    "ExtensionFindingV1": {
      "additionalProperties": false,
      "description": "One advisory observation emitted by an extension; it cannot allow an action.",
      "properties": {
        "check_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Check Id",
          "type": "string"
        },
        "evidence_event_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 2048,
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "outcome": {
          "enum": [
            "pass",
            "finding",
            "inconclusive",
            "error"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason_code": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Reason Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "outcome",
        "severity",
        "reason_code",
        "evidence_event_ids"
      ],
      "title": "ExtensionFindingV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Content-bound result from one explicit extension invocation.",
  "properties": {
    "evidence_class": {
      "enum": [
        "deterministic_rule",
        "heuristic_unreviewed",
        "producer_declared",
        "external_unreviewed"
      ],
      "title": "Evidence Class",
      "type": "string"
    },
    "extension_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Extension Id",
      "type": "string"
    },
    "extension_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Extension Manifest Sha256",
      "type": "string"
    },
    "extension_version": {
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$",
      "title": "Extension Version",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ExtensionFindingV1"
      },
      "maxItems": 512,
      "minItems": 1,
      "title": "Findings",
      "type": "array"
    },
    "input_envelope_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Envelope Id",
      "type": "string"
    },
    "input_envelope_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Envelope Sha256",
      "type": "string"
    },
    "operational_authority": {
      "const": "none",
      "title": "Operational Authority",
      "type": "string"
    },
    "result_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Id",
      "type": "string"
    },
    "schema_version": {
      "const": "harness-extension-result-v1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "verdict_semantics": {
      "const": "advisory_only_no_operational_effect",
      "title": "Verdict Semantics",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "result_id",
    "extension_id",
    "extension_version",
    "extension_manifest_sha256",
    "input_envelope_id",
    "input_envelope_sha256",
    "findings",
    "evidence_class",
    "verdict_semantics",
    "operational_authority"
  ],
  "title": "ExtensionResultV1",
  "type": "object"
}
