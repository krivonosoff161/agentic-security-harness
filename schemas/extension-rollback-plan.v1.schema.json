{
  "additionalProperties": false,
  "description": "Non-executable plan from one disabled approval to one approved target.",
  "properties": {
    "application_action_required": {
      "const": "construct_and_bind_target_object",
      "title": "Application Action Required",
      "type": "string"
    },
    "automatic_download": {
      "const": false,
      "title": "Automatic Download",
      "type": "boolean"
    },
    "automatic_import": {
      "const": false,
      "title": "Automatic Import",
      "type": "boolean"
    },
    "code_loaded": {
      "const": false,
      "title": "Code Loaded",
      "type": "boolean"
    },
    "current_approval_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Current Approval Id",
      "type": "string"
    },
    "current_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Current Manifest Sha256",
      "type": "string"
    },
    "disable_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Disable Id",
      "type": "string"
    },
    "distribution_name": {
      "maxLength": 128,
      "minLength": 1,
