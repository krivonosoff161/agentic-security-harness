      "type": "string"
    },
    "executable_state_changed": {
      "const": false,
      "title": "Executable State Changed",
      "type": "boolean"
    },
    "extension_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Extension Id",
      "type": "string"
    },
    "from_distribution_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "From Distribution Version",
      "type": "string"
    },
    "from_extension_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "From Extension Version",
      "type": "string"
    },
    "operational_authority": {
      "const": "none",
      "title": "Operational Authority",
      "type": "string"
    },
    "operator_action_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Operator Action Sha256",
      "type": "string"
    },
    "operator_authenticated": {
      "const": false,
      "title": "Operator Authenticated",
      "type": "boolean"
    },
    "rollback_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Rollback Plan Id",
      "type": "string"
    },
    "schema_version": {
      "const": "harness-extension-distribution-rollback-plan-v1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "const": "rollback_planned_non_executable",
      "title": "State",
      "type": "string"
    },
    "target_approval_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Approval Id",
      "type": "string"
    },
    "target_configuration_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Configuration Sha256",
      "type": "string"
    },
    "target_implementation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Implementation Sha256",
      "type": "string"
    },
    "target_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Manifest Sha256",
      "type": "string"
    },
    "to_distribution_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "To Distribution Version",
      "type": "string"
    },
    "to_extension_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "To Extension Version",
      "type": "string"
    },
    "version_direction_verified": {
      "const": false,
      "title": "Version Direction Verified",
      "type": "boolean"
    }
