{
  "$defs": {
    "CanonicalObservationEventV1": {
      "additionalProperties": false,
      "description": "Stable authority-free wire observation.\n\n``event_id`` remains a producer-claimed digest-shaped identifier. The separate\n:class:`ObservationCommitmentV1` binds canonical bytes without promoting that claim.",
      "properties": {
        "activity": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Activity",
          "type": "string"
        },
        "authority_envelope_ref": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Authority Envelope Ref"
        },
        "data_envelope_ref": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Data Envelope Ref",
          "type": "string"
        },
        "entity_refs": {
          "items": {
            "$ref": "#/$defs/SafeEvidencePointer"
          },
          "maxItems": 64,
          "title": "Entity Refs",
          "type": "array"
        },
        "event_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Event Id",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "operational_authority": {
          "const": "none",
          "title": "Operational Authority",
          "type": "string"
        },
        "parent_event_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Parent Event Ids",
          "type": "array"
        },
        "producer_attestation": {
          "const": "unattested",
          "title": "Producer Attestation",
          "type": "string"
        },
        "producer_id_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Producer Id Hash",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,127}$",
          "title": "Project Id",
          "type": "string"
        },
        "repository_id": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repository Id",
          "type": "string"
        },
        "repository_sha": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Repository Sha",
          "type": "string"
        },
        "schema_version": {
          "const": "portfolio-observation-v1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_surface": {
          "enum": [
            "user",
            "agent",
            "model",
            "tool",
            "mcp",
            "retrieval",
            "memory",
            "document",
            "app",
            "sensor",
            "environment",
            "provider",
            "audit"
          ],
          "title": "Source Surface",
          "type": "string"
        },
        "telemetry_state": {
          "enum": [
            "complete",
            "incomplete",
            "malformed",
            "unattested",
            "conflicting"
          ],
          "title": "Telemetry State",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "project_id",
        "repository_id",
        "repository_sha",
        "occurred_at",
        "producer_id_hash",
        "producer_attestation",
        "source_surface",
        "activity",
        "entity_refs",
        "parent_event_ids",
        "data_envelope_ref",
        "authority_envelope_ref",
        "telemetry_state",
        "operational_authority"
      ],
      "title": "CanonicalObservationEventV1",
      "type": "object"
    },
    "ExtensionFindingV1": {
      "additionalProperties": false,
      "description": "One advisory observation emitted by an extension; it cannot allow an action.",
      "properties": {
        "check_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Check Id",
          "type": "string"
        },
        "evidence_event_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 2048,
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "outcome": {
          "enum": [
            "pass",
            "finding",
            "inconclusive",
            "error"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason_code": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Reason Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "outcome",
        "severity",
        "reason_code",
        "evidence_event_ids"
      ],
      "title": "ExtensionFindingV1",
      "type": "object"
    },
    "ExtensionObservationEnvelopeV1": {
      "additionalProperties": false,
      "description": "Self-contained ordered observation graph passed between extensions.",
      "properties": {
        "envelope_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Envelope Id",
          "type": "string"
        },
        "event_commitments": {
          "items": {
            "$ref": "#/$defs/ObservationCommitmentV1"
          },
          "maxItems": 2048,
          "minItems": 1,
          "title": "Event Commitments",
          "type": "array"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/CanonicalObservationEventV1"
          },
          "maxItems": 2048,
          "minItems": 1,
          "title": "Events",
          "type": "array"
        },
        "extension_chain": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Extension Chain",
          "type": "array"
        },
        "operational_authority": {
          "const": "none",
          "title": "Operational Authority",
          "type": "string"
        },
        "schema_version": {
          "const": "harness-extension-envelope-v1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_commitment_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Commitment Sha256",
          "type": "string"
        },
        "source_component_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,127}$",
          "title": "Source Component Id",
          "type": "string"
        },
        "verdict_semantics": {
          "const": "observation_only_no_security_verdict",
          "title": "Verdict Semantics",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "envelope_id",
        "source_component_id",
        "source_commitment_sha256",
        "events",
        "event_commitments",
        "extension_chain",
        "verdict_semantics",
        "operational_authority"
      ],
      "title": "ExtensionObservationEnvelopeV1",
      "type": "object"
    },
    "ExtensionResultV1": {
      "additionalProperties": false,
      "description": "Content-bound result from one explicit extension invocation.",
      "properties": {
        "evidence_class": {
          "enum": [
            "deterministic_rule",
            "heuristic_unreviewed",
            "producer_declared",
            "external_unreviewed"
          ],
          "title": "Evidence Class",
          "type": "string"
        },
        "extension_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Extension Id",
          "type": "string"
        },
        "extension_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Extension Manifest Sha256",
          "type": "string"
        },
        "extension_version": {
          "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$",
          "title": "Extension Version",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/ExtensionFindingV1"
          },
          "maxItems": 512,
          "minItems": 1,
          "title": "Findings",
          "type": "array"
        },
        "input_envelope_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Envelope Id",
          "type": "string"
        },
        "input_envelope_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Envelope Sha256",
          "type": "string"
        },
        "operational_authority": {
          "const": "none",
          "title": "Operational Authority",
          "type": "string"
        },
        "result_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Id",
          "type": "string"
        },
        "schema_version": {
          "const": "harness-extension-result-v1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "verdict_semantics": {
          "const": "advisory_only_no_operational_effect",
          "title": "Verdict Semantics",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "result_id",
        "extension_id",
        "extension_version",
        "extension_manifest_sha256",
        "input_envelope_id",
        "input_envelope_sha256",
        "findings",
        "evidence_class",
        "verdict_semantics",
        "operational_authority"
      ],
      "title": "ExtensionResultV1",
      "type": "object"
    },
    "ObservationCommitmentV1": {
      "additionalProperties": false,
      "description": "Domain-separated commitment to exact canonical observation bytes.",
      "properties": {
        "commitment_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Commitment Sha256",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "domain": {
          "const": "agentic-security-portfolio/observation/v1.0",
          "title": "Domain",
          "type": "string"
        },
        "observation_schema_version": {
          "const": "portfolio-observation-v1.0",
          "title": "Observation Schema Version",
          "type": "string"
        },
        "operational_authority": {
          "const": "none",
          "title": "Operational Authority",
          "type": "string"
        },
        "schema_version": {
          "const": "portfolio-observation-commitment-v1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "observation_schema_version",
        "domain",
        "content_sha256",
        "commitment_sha256",
        "operational_authority"
      ],
      "title": "ObservationCommitmentV1",
      "type": "object"
    },
    "SafeEvidencePointer": {
      "additionalProperties": false,
      "description": "Digest-shaped pointer with no raw payload or machine path.\n\nShape validation does not prove that the referenced content exists or is authentic.",
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "kind": {
          "enum": [
            "artifact",
            "event",
            "policy",
            "trace",
            "report"
          ],
          "title": "Kind",
          "type": "string"
        },
        "locator_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Locator Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "digest",
        "locator_id"
      ],
      "title": "SafeEvidencePointer",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One input/result/output transition in the extension pipeline.",
  "properties": {
    "execution_semantics": {
      "const": "explicit_in_process_not_sandboxed",
      "title": "Execution Semantics",
      "type": "string"
    },
    "input_envelope_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Envelope Sha256",
      "type": "string"
    },
    "operational_authority": {
      "const": "none",
      "title": "Operational Authority",
      "type": "string"
    },
    "output_envelope": {
      "$ref": "#/$defs/ExtensionObservationEnvelopeV1"
    },
    "receipt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "result": {
      "$ref": "#/$defs/ExtensionResultV1"
    },
    "schema_version": {
      "const": "harness-extension-run-receipt-v1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "receipt_id",
    "input_envelope_sha256",
    "result",
    "output_envelope",
    "execution_semantics",
    "operational_authority"
  ],
  "title": "ExtensionRunReceiptV1",
  "type": "object"
}
